# Copy to .env and fill in whichever live sources you have configured.
# Every value is optional -- anything left unset falls back to the
# synthetic data generator for that source. See README.md "Data modes".

# Microsoft Planetary Computer (Sentinel-2 / Landsat-8-9 / MODIS)
# Optional: the catalog and data are public without one. A free key just
# raises your request-rate limit -- get one at
# https://planetarycomputer.microsoft.com/account/request
PC_SDK_SUBSCRIPTION_KEY=

# Copernicus Climate Data Store (ERA5)
CDS_API_KEY=

# OpenAQ v3
OPENAQ_API_KEY=

# Precipitation (NASA POWER) needs no key -- it's always on.

# Platform tuning (all have sensible defaults, see geovision/config.py)
INGESTION_INTERVAL_MIN=60
DEFAULT_SCALE_M=250
FORECAST_HORIZON_DAYS=14
